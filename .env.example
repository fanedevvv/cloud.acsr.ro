# Copiază în .env sau rulează: npm run set-password -- PAROLA_TA
# .env NU se comite (e în .gitignore).

# Hash bcrypt al parolei de acces (generat de `npm run set-password`)
PASSWORD_HASH=

# Secret pentru semnarea sesiunilor (string lung, aleator)
SESSION_SECRET=

# Portul pe care ascultă serverul Node (localhost)
PORT=4300

# true DOAR când rulează în spatele HTTPS (nginx cu TLS). Local pe http lasă false.
COOKIE_SECURE=false

# Dimensiune maximă per fișier, în MB
MAX_UPLOAD_MB=2048

# Spațiul total afișat în bara „Stocare” (GB). Gol = spațiul real al discului.
STORAGE_LIMIT_GB=

# Comprimă pozele la încărcare în WebP (calitate înaltă, ~15-35% mai mic).
# webp (implicit) | off
OPTIMIZE_UPLOADS=webp

# Cont de administrator (poate șterge). User implicit: „admin”.
# Setează parola cu:  npm run set-admin -- PAROLA
ADMIN_PASSWORD_HASH=
# ADMIN_USER=admin
