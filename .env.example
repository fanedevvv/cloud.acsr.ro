# Copiază în .env sau rulează: npm run set-password -- PAROLA_TA
# .env NU se comite (e în .gitignore).

# Hash bcrypt al PAROLEI DE ADMIN (ștergere). Restul accesului e liber.
# Generat de: npm run set-password -- PAROLA
PASSWORD_HASH=

# Secret pentru semnarea sesiunilor (string lung, aleator)
SESSION_SECRET=

# Portul pe care ascultă serverul Node (localhost)
PORT=4300

# true DOAR când rulează în spatele HTTPS (nginx cu TLS). Local pe http lasă false.
COOKIE_SECURE=false

# Dimensiune maximă per fișier, în MB
MAX_UPLOAD_MB=2048

# Spațiul total afișat în bara „Stocare” (GB). Gol = spațiul real al discului.
STORAGE_LIMIT_GB=

# Comprimă pozele la încărcare în WebP (calitate înaltă, ~15-35% mai mic).
# webp (implicit) | off
OPTIMIZE_UPLOADS=webp


# URL webhook pentru notificări la comentarii pe albumele partajate (opțional).
# Compatibil Discord/Slack/ntfy — trimite { content, album, name, body, emoji, url }.
COMMENT_WEBHOOK=

# Login cu Google (opțional). Creează un OAuth 2.0 Client ID (tip „Web application")
# în Google Cloud Console și adaugă redirect URI: https://cloud.acsr.ro/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Lasă gol ca să se folosească https://<host>/auth/google/callback
GOOGLE_REDIRECT_URI=

# MariaDB — galeria rulează acum pe MySQL/MariaDB, nu SQLite.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cloud_gallery
DB_USER=cloud_gallery
DB_PASSWORD=
